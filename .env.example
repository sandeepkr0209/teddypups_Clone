# Server-side only (Vercel → Project → Settings → Environment Variables).
# If these are not set, /api/enquiry returns 503 and the forms offer WhatsApp instead
# of pretending the enquiry was delivered.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Optional: verified sender on your Resend domain (defaults to Resend's onboarding sender)
ENQUIRY_FROM_EMAIL=
